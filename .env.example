# AI Coach 环境变量模板
# 复制本文件为 .env.local 后填入真实值。.env.local 已被 .gitignore 屏蔽。

# ─── 主 AI 服务（通用云端模型；可在网页设置里继续调整） ───
# provider: 任意标识，目前只用作日志
AI_COACH_PROVIDER=deepseek
# OpenAI 兼容 API 的 baseUrl（注意末尾不要 /v1）
AI_COACH_BASE_URL=https://api.deepseek.com/v1/chat/completions
# API key（请从对应平台获取）
AI_COACH_KEY=your-api-key-here
# 模型名
AI_COACH_MODEL=deepseek-v4-flash

# ─── 可选：DeepSeek 双模型注册（设置后优先用它们覆盖当前主路由） ───
# DEEPSEEK_KEY=your-deepseek-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# DEEPSEEK_PRO_MODEL=deepseek-v4-pro

# ─── 后端 OCR / 视觉服务（仅 server 用，处理 OJ 题目里的图片） ───
# Ollama base URL（默认本机）
AICC_OLLAMA_BASE=http://127.0.0.1:11434
# 视觉模型（推荐 sam:latest 或 minicpm-v）
AICC_VISION_MODEL=sam:latest
